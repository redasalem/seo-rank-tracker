# ==========================================
# SERVER ENVIRONMENT VARIABLES
# ==========================================

# 1. Server Configuration
PORT="5000"
NODE_ENV="development" # Use "production" in Vercel

# 2. Frontend Configuration
FRONTEND_URL="http://localhost:5173" # Use your Vercel frontend URL in production

# 3. Database
MONGODB_URL="mongodb://127.0.0.1:27017/seo"

# 4. Authentication (JWT)
JWT_SECRET="your_jwt_secret_key_here_make_it_long_and_secure"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_here"

# 5. AI & Scraping
BROWSERBASE_API_KEY="your_browserbase_api_key_here"
BROWSERBASE_PROJECT_ID="your_browserbase_project_id_here"
SERPAPI_API_KEY="your_serpapi_api_key_here"

# 6. Cron Jobs (Vercel)
CRON_SECRET="your_cron_secret_here_for_vercel"

# 7. Subscription (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 8. Email Service (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password_here"
SMTP_SENDER="\"RankBoost\" <noreply@rankboost.com>"
