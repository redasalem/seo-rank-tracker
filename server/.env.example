PORT="5000"

# MongoDB Connection URL (Local or Cloud)
MONGODB_URL="mongodb://127.0.0.1:27017/seo"

# JWT Secret for Authentication
JWT_SECRET="your_jwt_secret_here"

# Browserbase API Key and Project ID for Scraping
BROWSERBASE_API_KEY="your_browserbase_api_key_here"
BROWSERBASE_PROJECT_ID="your_browserbase_project_id_here"

# Frontend URL for CORS Protection (Add the Vercel deployed frontend URL here)
FRONTEND_URL="https://seo-rank-tracer-frontend.vercel.app"

# Secret for securing Vercel Cron Jobs
#cron_sec_X9yK2mP7vL4nR1wQ
CRON_SECRET="your_cron_secret_here"
